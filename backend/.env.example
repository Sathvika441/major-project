# Copy these values into your local shell/environment; do not commit real secrets.
# Required to enable Firebase-authenticated app endpoints and Firestore history.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Keep the service-account JSON outside the repository. In PowerShell set:
# $env:GOOGLE_APPLICATION_CREDENTIALS = "C:\secure\path\firebase-admin-service-account.json"
GOOGLE_APPLICATION_CREDENTIALS=
# Separate shared credential used only by trusted ESP32 hardware.
ARECASMART_IOT_API_TOKEN=replace-with-a-long-random-device-token
